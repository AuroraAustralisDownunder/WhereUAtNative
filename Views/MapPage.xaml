<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WhereUAtNative.Views.MapPage"
             Title="Where U At"
             BackgroundColor="#1C1C1E"
             Shell.NavBarIsVisible="True">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Settings"
                     Order="Primary"
                     Priority="0"
                     Command="{Binding OpenSettingsCommand}" />
    </ContentPage.ToolbarItems>

    <Grid>
        <!-- Full-bleed OSM Leaflet map -->
        <WebView x:Name="MapWebView"
                 Navigated="OnMapWebViewNavigated" />

        <!-- Soft empty-state overlay at bottom (map stays clear) -->
        <Border IsVisible="{Binding ShowEmptyOverlay}"
                BackgroundColor="#CC1C1C1E"
                StrokeThickness="0"
                Padding="20,14"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                Margin="16,0,16,24"
                MaximumWidthRequest="420"
                StrokeShape="RoundRectangle 14">
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding StatusMessage}"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       TextColor="#E5E5EA"
                       LineBreakMode="WordWrap" />
                <Label Text="Use the pin button to share · Settings for family"
                       FontSize="12"
                       HorizontalTextAlignment="Center"
                       TextColor="#8E8E93"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Border>


        <!-- Toggle hint (permission / GPS) — bottom, clear of mid-right FABs -->
        <Border IsVisible="{Binding IsToggleHintVisible}"
                StrokeThickness="0"
                BackgroundColor="#E62C2C2E"
                StrokeShape="RoundRectangle 10"
                Padding="12,8"
                Margin="12,0,72,24"
                VerticalOptions="End"
                HorizontalOptions="Fill">
            <Label Text="{Binding ToggleHint}"
                   FontSize="12"
                   TextColor="#FFB74D"
                   LineBreakMode="WordWrap" />
        </Border>

        <!-- Mid-right FAB column: pin (share) then padlock (unlock follow) -->
        <VerticalStackLayout HorizontalOptions="End"
                             VerticalOptions="Center"
                             Margin="0,0,18,0"
                             TranslationY="-36"
                             Spacing="14">

            <!-- Location sharing FAB (primary) -->
            <Button WidthRequest="58"
                    HeightRequest="58"
                    CornerRadius="29"
                    Padding="0"
                    FontSize="22"
                    Text="{Binding SharingFabLabel}"
                    TextColor="{Binding SharingFabTextColor}"
                    BackgroundColor="{Binding SharingFabColor}"
                    Command="{Binding ToggleSharingCommand}"
                    SemanticProperties.Description="Toggle location sharing" />

            <!-- Unlock follow FAB — padlock under pin -->
            <Button WidthRequest="48"
                    HeightRequest="48"
                    CornerRadius="24"
                    Padding="0"
                    FontSize="20"
                    Text="🔒"
                    TextColor="#FFFFFF"
                    BackgroundColor="{Binding UnlockFabColor}"
                    IsVisible="{Binding IsUnlockFabVisible}"
                    Command="{Binding UnlockFollowCommand}"
                    SemanticProperties.Description="Unlock map follow" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
