<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WhereUAtNative.Views.LoginPage"
             Title="Family Tracker Login"
             BackgroundColor="#1C1C1E">

    <!-- Start near top so soft keyboard doesn't cover email/password -->
    <ScrollView VerticalOptions="Fill"
                VerticalScrollBarVisibility="Never">
    <VerticalStackLayout Spacing="20"
                         Padding="30,48,30,30"
                         VerticalOptions="Start"
                         MaximumWidthRequest="400">

        <Label Text="Family Tracker"
               FontSize="32"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#FFFFFF"
               Margin="0,0,0,4" />

        <Label Text="Where U At"
               FontSize="16"
               HorizontalOptions="Center"
               TextColor="#AEAEB2"
               Margin="0,0,0,16" />

        <!-- Bordered fields without Material underline (handler clears Android tint) -->
        <Border Stroke="#3A3A3C"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="#3A3A3C"
                Padding="12,4">
            <Entry x:Name="EmailEntry"
                   Placeholder="Email"
                   PlaceholderColor="#8E8E93"
                   Keyboard="Email"
                   ClearButtonVisibility="WhileEditing"
                   Text="{Binding Email}"
                   TextColor="#FFFFFF"
                   BackgroundColor="Transparent"
                   IsEnabled="{Binding IsNotBusy}" />
        </Border>

        <Border Stroke="#3A3A3C"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="#3A3A3C"
                Padding="12,4">
            <Entry x:Name="PasswordEntry"
                   Placeholder="Password"
                   PlaceholderColor="#8E8E93"
                   IsPassword="True"
                   ClearButtonVisibility="WhileEditing"
                   Text="{Binding Password}"
                   TextColor="#FFFFFF"
                   BackgroundColor="Transparent"
                   IsEnabled="{Binding IsNotBusy}" />
        </Border>

        <Button Text="Secure Login"
                BackgroundColor="#4CAF50"
                TextColor="White"
                CornerRadius="8"
                HeightRequest="50"
                FontAttributes="Bold"
                Command="{Binding LoginCommand}"
                IsEnabled="{Binding IsNotBusy}" />

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="#FFFFFF"
                           HeightRequest="36" />

        <Label Text="{Binding StatusMessage}"
               TextColor="#AEAEB2"
               HorizontalOptions="Center"
               IsVisible="{Binding IsStatusVisible}" />

        <Label Text="{Binding ErrorMessage}"
               TextColor="#E53935"
               HorizontalOptions="Center"
               IsVisible="{Binding IsErrorVisible}" />

    </VerticalStackLayout>
    </ScrollView>
</ContentPage>
