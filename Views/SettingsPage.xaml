<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WhereUAtNative.Views.SettingsPage"
             Title="Settings"
             BackgroundColor="#1C1C1E">

    <ScrollView>
        <VerticalStackLayout Spacing="20"
                             Padding="24"
                             VerticalOptions="Start"
                             MaximumWidthRequest="420">

            <Border Stroke="#3A3A3C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="#2C2C2E"
                    Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Account"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#FFFFFF" />
                    <Label Text="{Binding AccountEmail}"
                           FontSize="15"
                           TextColor="#E5E5EA"
                           LineBreakMode="MiddleTruncation" />
                    <Label Text="Your coordinates"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#8E8E93"
                           Margin="0,8,0,0" />
                    <Label Text="{Binding LocationStatusText}"
                           FontSize="14"
                           TextColor="#E5E5EA"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>


            <Border Stroke="#3A3A3C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="#2C2C2E"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Map display"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#FFFFFF" />
                    <Label Text="Alias name — shown above your pin on the map"
                           FontSize="13"
                           TextColor="#8E8E93" />
                    <Entry Text="{Binding AliasName, Mode=TwoWay}"
                           Placeholder="You"
                           PlaceholderColor="#8E8E93"
                           TextColor="#FFFFFF"
                           BackgroundColor="#1C1C1E"
                           MaxLength="24"
                           HeightRequest="44" />
                    <Button Text="Save alias"
                            BackgroundColor="#3A3A3C"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="40"
                            Command="{Binding SaveAliasCommand}"
                            IsEnabled="{Binding IsNotBusy}" />

                    <Label Text="Your pin colour"
                           FontSize="13"
                           TextColor="#8E8E93"
                           Margin="0,4,0,0" />
                    <Label Text="{Binding SelectedPinColorName, StringFormat='Selected: {0}'}"
                           FontSize="13"
                           TextColor="#E5E5EA" />

                    <!-- Simple colour swatches (tap to choose); horizontal scroll so they stay on-screen -->
                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Default"
                                VerticalScrollBarVisibility="Never"
                                HeightRequest="48">
                    <HorizontalStackLayout Spacing="10">
                        <Button WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0"
                                Text="" BackgroundColor="#B794F6" TextColor="Transparent"
                                Command="{Binding SelectPinColorCommand}" CommandParameter="#B794F6"
                                SemanticProperties.Description="Light purple" />
                        <Button WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0"
                                Text="" BackgroundColor="#64B5F6" TextColor="Transparent"
                                Command="{Binding SelectPinColorCommand}" CommandParameter="#64B5F6"
                                SemanticProperties.Description="Soft blue" />
                        <Button WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0"
                                Text="" BackgroundColor="#4DB6AC" TextColor="Transparent"
                                Command="{Binding SelectPinColorCommand}" CommandParameter="#4DB6AC"
                                SemanticProperties.Description="Soft teal" />
                        <Button WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0"
                                Text="" BackgroundColor="#F48FB1" TextColor="Transparent"
                                Command="{Binding SelectPinColorCommand}" CommandParameter="#F48FB1"
                                SemanticProperties.Description="Soft pink" />
                        <Button WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0"
                                Text="" BackgroundColor="#FFB74D" TextColor="Transparent"
                                Command="{Binding SelectPinColorCommand}" CommandParameter="#FFB74D"
                                SemanticProperties.Description="Soft orange" />
                        <Button WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0"
                                Text="" BackgroundColor="#81C784" TextColor="Transparent"
                                Command="{Binding SelectPinColorCommand}" CommandParameter="#81C784"
                                SemanticProperties.Description="Muted green" />
                        <Button WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0"
                                Text="" BackgroundColor="#7986CB" TextColor="Transparent"
                                Command="{Binding SelectPinColorCommand}" CommandParameter="#7986CB"
                                SemanticProperties.Description="Soft indigo" />
                    </HorizontalStackLayout>
                    </ScrollView>

                    <Label Text="{Binding DisplayHint}"
                           FontSize="13"
                           TextColor="#FFB74D"
                           IsVisible="{Binding IsDisplayHintVisible}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#3A3A3C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="#2C2C2E"
                    Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Privacy"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#FFFFFF" />
                    <Label Text="{Binding PrivacyReminder}"
                           FontSize="14"
                           TextColor="#AEAEB2"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#3A3A3C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="#2C2C2E"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Family"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#FFFFFF" />

                    <Label Text="{Binding FamilyStatusText}"
                           FontSize="14"
                           TextColor="#AEAEB2"
                           LineBreakMode="WordWrap" />

                    <Label Text="{Binding FamilyHint}"
                           FontSize="13"
                           TextColor="#FFB74D"
                           IsVisible="{Binding IsFamilyHintVisible}"
                           LineBreakMode="WordWrap" />

                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding IsNotInFamily}">
                        <Button Text="Create family"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="44"
                                Command="{Binding CreateFamilyCommand}"
                                IsEnabled="{Binding IsNotBusy}" />

                        <Label Text="Or join with a code"
                               FontSize="13"
                               TextColor="#8E8E93" />

                        <Entry Text="{Binding JoinCodeInput, Mode=TwoWay}"
                               Placeholder="6-character code"
                               PlaceholderColor="#8E8E93"
                               TextColor="#FFFFFF"
                               BackgroundColor="#1C1C1E"
                               MaxLength="8"
                               Keyboard="Text"
                               HeightRequest="44" />

                        <Button Text="Join family"
                                BackgroundColor="#3A3A3C"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="44"
                                Command="{Binding JoinFamilyCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding IsInFamily}">
                        <Label Text="Share this code so others can join:"
                               FontSize="13"
                               TextColor="#8E8E93" />
                        <Label Text="{Binding FamilyCode}"
                               FontSize="28"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#FFD54F"
                               CharacterSpacing="4" />

                        <CollectionView ItemsSource="{Binding MemberLabels}"
                                        HeightRequest="120">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}"
                                           FontSize="14"
                                           TextColor="#E5E5EA"
                                           Padding="0,4" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button Text="Leave family"
                                BackgroundColor="#E53935"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="44"
                                Command="{Binding LeaveFamilyCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>


            <Border Stroke="#3A3A3C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="#2C2C2E"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Diagnostics"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#FFFFFF" />
                    <Label Text="Crash log stays on this device only (never uploaded). It omits passwords, tokens, and precise coordinates. Share or copy it so the developer can see what failed."
                           FontSize="13"
                           TextColor="#AEAEB2"
                           LineBreakMode="WordWrap" />
                    <Label Text="{Binding CrashLogHint}"
                           FontSize="13"
                           TextColor="#FFB74D"
                           IsVisible="{Binding IsCrashLogHintVisible}"
                           LineBreakMode="WordWrap" />
                    <Button Text="Share crash log"
                            BackgroundColor="#3A3A3C"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="44"
                            Command="{Binding ShareCrashLogCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <Button Text="Copy crash log"
                            BackgroundColor="#3A3A3C"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="44"
                            Command="{Binding CopyCrashLogCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <Button Text="Clear crash log"
                            BackgroundColor="#2C2C2E"
                            TextColor="#AEAEB2"
                            BorderColor="#3A3A3C"
                            BorderWidth="1"
                            CornerRadius="10"
                            HeightRequest="44"
                            Command="{Binding ClearCrashLogCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#4CAF50"
                               HeightRequest="36" />

            <Button Text="Sign out"
                    BackgroundColor="#E53935"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="48"
                    Command="{Binding SignOutCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

            <Button Text="Done"
                    BackgroundColor="#3A3A3C"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="48"
                    Command="{Binding CloseCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
