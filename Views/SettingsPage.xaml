<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WhereUAtNative.Views.SettingsPage"
             Title="Settings"
             BackgroundColor="#1C1C1E">

    <ScrollView>
        <VerticalStackLayout Spacing="20"
                             Padding="24"
                             VerticalOptions="Start"
                             MaximumWidthRequest="420">

            <Border Stroke="#3A3A3C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="#2C2C2E"
                    Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Account"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#FFFFFF" />
                    <Label Text="{Binding AccountEmail}"
                           FontSize="15"
                           TextColor="#E5E5EA"
                           LineBreakMode="MiddleTruncation" />
                    <Label Text="{Binding LocationStatusText}"
                           FontSize="13"
                           TextColor="#AEAEB2"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#3A3A3C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="#2C2C2E"
                    Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Privacy"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#FFFFFF" />
                    <Label Text="{Binding PrivacyReminder}"
                           FontSize="14"
                           TextColor="#AEAEB2"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#3A3A3C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="#2C2C2E"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Family"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#FFFFFF" />

                    <Label Text="{Binding FamilyStatusText}"
                           FontSize="14"
                           TextColor="#AEAEB2"
                           LineBreakMode="WordWrap" />

                    <Label Text="{Binding FamilyHint}"
                           FontSize="13"
                           TextColor="#FFB74D"
                           IsVisible="{Binding IsFamilyHintVisible}"
                           LineBreakMode="WordWrap" />

                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding IsNotInFamily}">
                        <Button Text="Create family"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="44"
                                Command="{Binding CreateFamilyCommand}"
                                IsEnabled="{Binding IsNotBusy}" />

                        <Label Text="Or join with a code"
                               FontSize="13"
                               TextColor="#8E8E93" />

                        <Entry Text="{Binding JoinCodeInput, Mode=TwoWay}"
                               Placeholder="6-character code"
                               PlaceholderColor="#8E8E93"
                               TextColor="#FFFFFF"
                               BackgroundColor="#1C1C1E"
                               MaxLength="8"
                               Keyboard="Text"
                               HeightRequest="44" />

                        <Button Text="Join family"
                                BackgroundColor="#3A3A3C"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="44"
                                Command="{Binding JoinFamilyCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding IsInFamily}">
                        <Label Text="Share this code so others can join:"
                               FontSize="13"
                               TextColor="#8E8E93" />
                        <Label Text="{Binding FamilyCode}"
                               FontSize="28"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#FFD54F"
                               CharacterSpacing="4" />

                        <CollectionView ItemsSource="{Binding MemberLabels}"
                                        HeightRequest="120">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}"
                                           FontSize="14"
                                           TextColor="#E5E5EA"
                                           Padding="0,4" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button Text="Leave family"
                                BackgroundColor="#E53935"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="44"
                                Command="{Binding LeaveFamilyCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>


            <Border Stroke="#3A3A3C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="#2C2C2E"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Diagnostics"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#FFFFFF" />
                    <Label Text="Crash log stays on this device only (never uploaded). It omits passwords, tokens, and precise coordinates. Share or copy it so the developer can see what failed."
                           FontSize="13"
                           TextColor="#AEAEB2"
                           LineBreakMode="WordWrap" />
                    <Label Text="{Binding CrashLogHint}"
                           FontSize="13"
                           TextColor="#FFB74D"
                           IsVisible="{Binding IsCrashLogHintVisible}"
                           LineBreakMode="WordWrap" />
                    <Button Text="Share crash log"
                            BackgroundColor="#3A3A3C"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="44"
                            Command="{Binding ShareCrashLogCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <Button Text="Copy crash log"
                            BackgroundColor="#3A3A3C"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="44"
                            Command="{Binding CopyCrashLogCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <Button Text="Clear crash log"
                            BackgroundColor="#2C2C2E"
                            TextColor="#AEAEB2"
                            BorderColor="#3A3A3C"
                            BorderWidth="1"
                            CornerRadius="10"
                            HeightRequest="44"
                            Command="{Binding ClearCrashLogCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#4CAF50"
                               HeightRequest="36" />

            <Button Text="Done"
                    BackgroundColor="#3A3A3C"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="48"
                    Command="{Binding CloseCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
