<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WhereUAtNative.Views.HomePage"
             Title="Where U At"
             BackgroundColor="#1C1C1E">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Map"
                     Command="{Binding OpenMapCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="20"
                             Padding="30"
                             VerticalOptions="Start"
                             MaximumWidthRequest="420">

            <Label Text="Where U At"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#FFFFFF" />

            <Label Text="{Binding WelcomeText}"
                   FontSize="18"
                   HorizontalOptions="Center"
                   TextColor="#E5E5EA" />

            <Border Stroke="#3A3A3C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#2C2C2E"
                    Padding="16"
                    Margin="0,8,0,0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Privacy"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#FFFFFF" />
                    <Label Text="{Binding PrivacyReminder}"
                           FontSize="14"
                           TextColor="#AEAEB2"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#3A3A3C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#2C2C2E"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Location sharing"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#FFFFFF" />

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="Share my location"
                               FontSize="15"
                               VerticalOptions="Center"
                               TextColor="#E5E5EA" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsSharingEnabled, Mode=TwoWay}"
                                OnColor="#4CAF50"
                                VerticalOptions="Center" />
                    </Grid>

                    <Label Text="{Binding LocationStatusText}"
                           FontSize="14"
                           TextColor="#AEAEB2"
                           LineBreakMode="WordWrap" />

                    <Label Text="{Binding LocationHint}"
                           FontSize="13"
                           TextColor="#FFB74D"
                           IsVisible="{Binding IsLocationHintVisible}"
                           LineBreakMode="WordWrap" />

                    <Label Text="Tip: open Map from the toolbar to see yourself and family when sharing is on."
                           FontSize="12"
                           TextColor="#8E8E93"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#3A3A3C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#2C2C2E"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Family"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#FFFFFF" />

                    <Label Text="{Binding FamilyStatusText}"
                           FontSize="14"
                           TextColor="#AEAEB2"
                           LineBreakMode="WordWrap" />

                    <Label Text="{Binding FamilyHint}"
                           FontSize="13"
                           TextColor="#FFB74D"
                           IsVisible="{Binding IsFamilyHintVisible}"
                           LineBreakMode="WordWrap" />

                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding IsNotInFamily}">
                        <Button Text="Create family"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                CornerRadius="8"
                                HeightRequest="44"
                                Command="{Binding CreateFamilyCommand}"
                                IsEnabled="{Binding IsNotBusy}" />

                        <Label Text="Or join with a code"
                               FontSize="13"
                               TextColor="#8E8E93" />

                        <Entry Text="{Binding JoinCodeInput, Mode=TwoWay}"
                               Placeholder="6-character code"
                               PlaceholderColor="#8E8E93"
                               TextColor="#FFFFFF"
                               BackgroundColor="#1C1C1E"
                               MaxLength="8"
                               Keyboard="Text"
                               HeightRequest="44" />

                        <Button Text="Join family"
                                BackgroundColor="#3A3A3C"
                                TextColor="White"
                                CornerRadius="8"
                                HeightRequest="44"
                                Command="{Binding JoinFamilyCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding IsInFamily}">
                        <Label Text="Share this code so others can join:"
                               FontSize="13"
                               TextColor="#8E8E93" />
                        <Label Text="{Binding FamilyCode}"
                               FontSize="28"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#FFD54F"
                               CharacterSpacing="4" />

                        <CollectionView ItemsSource="{Binding MemberLabels}"
                                        HeightRequest="120">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}"
                                           FontSize="14"
                                           TextColor="#E5E5EA"
                                           Padding="0,4" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button Text="Leave family"
                                BackgroundColor="#E53935"
                                TextColor="White"
                                CornerRadius="8"
                                HeightRequest="44"
                                Command="{Binding LeaveFamilyCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#4CAF50"
                               HeightRequest="36" />

            <Button Text="Sign out"
                    BackgroundColor="#E53935"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    FontAttributes="Bold"
                    Command="{Binding SignOutCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
